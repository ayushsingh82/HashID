{
    "name": "credentialmint",
    "version": "0.1.0",
    "description": "Benchmark-verified skill credentials for AI agents on the CROO Agent Protocol",
    "main": "dist/index.js",
    "type": "module",
    "types": "dist/index.d.ts",
    "dependencies": {
        "@croo-network/sdk": "^0.2.1",
        "cors": "^2.8.6",
        "dotenv": "^16.4.7",
        "express": "^5.2.1",
        "tsup": "8.3.5",
        "zod": "^3.24.2"
    },
    "scripts": {
        "build": "tsup --format esm --dts",
        "dev": "tsup --format esm --dts --watch",
        "start": "node dist/index.js",
        "provider": "tsx watch src/index.ts",
        "server": "tsx watch src/server.ts",
        "benchmark": "tsx src/benchmark.ts",
        "test": "vitest run"
    },
    "devDependencies": {
        "@eslint/js": "^9.20.0",
        "@types/cors": "^2.8.19",
        "@types/express": "^5.0.6",
        "@types/node": "^26.1.1",
        "@typescript-eslint/eslint-plugin": "^8.24.0",
        "@typescript-eslint/parser": "^8.24.0",
        "eslint": "^9.20.1",
        "eslint-config-prettier": "^10.0.1",
        "prettier": "^3.5.0",
        "tsx": "^4.19.2",
        "typescript": "^5.7.3",
        "vitest": "^3.0.7"
    },
    "packageManager": "pnpm@9.15.0+sha512.76e2379760a4328ec4415815bcd6628dee727af3779aaa4c914e3944156c4299921a89f976381ee107d41f12cfa4b66681ca9c718f0668fa0831ed4c6d8ba56c"
}
