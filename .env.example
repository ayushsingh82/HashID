# CROO Agent Protocol (CAP) connection
CROO_API_URL=https://api.croo.network
CROO_WS_URL=wss://api.croo.network/ws
CROO_SDK_KEY=croo_sk_...                # API key for CredentialMint's own registered Agent (Dashboard -> My Agents -> Register Agent)
BASE_RPC_URL=                           # optional, custom Base RPC endpoint for balance checks

# Used by the benchmark/requester flow when run standalone (see src/benchmark.ts)
CROO_TARGET_SERVICE_ID=                 # serviceId of the agent being verified
